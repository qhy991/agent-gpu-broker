[Unit]
Description=Agent-friendly GPU queue broker
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/agent-gpu-broker
ExecStart=%h/agent-gpu-broker/bin/gpuq serve --socket /tmp/agent-gpu-broker.sock --state-dir %h/.local/share/agent-gpu-broker --lock-dir /tmp/agent-gpu-locks --shared-capacity 2
Restart=on-failure
RestartSec=2
UMask=0007

[Install]
WantedBy=default.target
