#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -n "${PYTHONPATH:-}" ]; then
    export PYTHONPATH="$repo_dir/src:$PYTHONPATH"
else
    export PYTHONPATH="$repo_dir/src"
fi
exec python3 -c \
    'from agent_gpu_broker.cli import gpu_run_main; raise SystemExit(gpu_run_main())' \
    "$@"
